<h1><%= title %></h1>

<% if (reviews && reviews.length > 0) { %>
  <div class="user-reviews-list">
    <% reviews.forEach(review => { %>
      <div class="review-card">
        <div class="vehicle-info">
          <h3><%= review.inv_year %> <%= review.inv_make %> <%= review.inv_model %></h3>
        </div>
        <div class="review-content">
          <h4><%= review.review_title %></h4>
          <div class="rating">
            <% for(let i = 1; i <= 5; i++) { %>
              <span class="star <%= i <= review.review_rating ? 'filled' : '' %>">★</span>
            <% } %>
          </div>
          <p><%= review.review_text %></p>
          <p class="review-date">Reviewed on: <%= new Date(review.review_date).toLocaleDateString() %></p>
        </div>
        <div class="review-actions">
          <a href="/reviews/delete/<%= review.review_id %>" 
             onclick="return confirm('Are you sure you want to delete this review?')"
             class="btn btn-danger btn-small">Delete Review</a>
        </div>
      </div>
    <% }) %>
  </div>
<% } else { %>
  <p>You haven't written any reviews yet.</p>
  <a href="/" class="btn btn-primary">Browse Vehicles to Review</a>
<% } %>