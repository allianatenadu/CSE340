<!-- views/account/management.ejs -->


<main>
    <div class="container">
        <h1>Account Management</h1>
        
        <!-- Flash Messages -->
        <% if (messages.notice) { %>
            <div class="alert alert-success">
                <%= messages.notice %>
            </div>
        <% } %>
        
        <% if (messages.error) { %>
            <div class="alert alert-danger">
                <%= messages.error %>
            </div>
        <% } %>
        
        <!-- Error Handling -->
        <% if (typeof errors !== 'undefined' && Array.isArray(errors)) { %>
            <div class="alert alert-danger">
                <ul class="error-list">
                    <% errors.forEach(function(error) { %>
                        <li><%= error.msg %></li>
                    <% }); %>
                </ul>
            </div>
        <% } %>
        
        <!-- Main Content -->
        <div class="account-content">
            <p>You're logged in</p>
            
            <!-- Display user information for testing -->
            <% if (typeof locals.accountData !== 'undefined' && locals.accountData) { %>
                <div style="margin-top: 20px; padding: 15px; background: #f0f0f0; border-radius: 5px;">
                    <h3>Account Information:</h3>
                    <p><strong>Name:</strong> <%= locals.accountData.account_firstname %> <%= locals.accountData.account_lastname %></p>
                    <p><strong>Email:</strong> <%= locals.accountData.account_email %></p>
                    <p><strong>Account Type:</strong> <%= locals.accountData.account_type %></p>
                    <p><strong>Account ID:</strong> <%= locals.accountData.account_id %></p>
                </div>
            <% } %>
        </div>
    </div>
</main>
